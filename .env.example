# Copy to .env.local and fill in.

# Encrypts the short-lived MFA cookie. At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Where Garmin tokens are stored (garth-compatible JSON). Default: .garmin-tokens
# GARMIN_TOKEN_DIR=.garmin-tokens

# Set to 1 to show synthetic data instead of connecting to Garmin.
# GARMIN_DEMO=1
